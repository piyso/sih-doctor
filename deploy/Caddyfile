# HTTPS reverse proxy.
# CADDY_TLS=internal (default): certificate from Caddy's own CA for a hospital LAN — trust that CA on each device once.
# CADDY_TLS=you@example.org: a public domain gets a Let's Encrypt certificate (ports 80/443 must be reachable).
{$HOSPITAL_HOSTNAME} {
	tls {$CADDY_TLS:internal}
	encode gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy frontend:80 {
		flush_interval -1
	}
}
