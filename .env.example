# Copy to .env next to docker-compose.yml. Never commit .env.
SETUP_CODE=change-me-to-a-long-random-code
HOSPITAL_HOSTNAME=hospital.local
# internal = LAN certificate from Caddy's own CA; or an e-mail address for a Let's Encrypt certificate on a public domain
CADDY_TLS=internal
HOSPITAL_SHORT_NAME=AIIA Hospital
HOSPITAL_TIMEZONE=Asia/Kolkata
CORS_ORIGIN=
ALLOW_DEMO_DATA=false
DEMO_TOGGLE=false
KIOSK_OPEN=false
BACKUP_HOST_DIR=./backups
SMS_PROVIDER=log
THERMAL_PRINTER_HOST=
EDGE_AI_TOKEN=change-me-too
# Model settings for the optional AI service (see edge-ai/README.md)
MODELS_DIR=./models
# Hindi + English speech recognition runs on CPU from MODELS_DIR/asr — fetch once with:
#   docker compose --profile ai run --rm edge-ai scripts/fetch_models.sh
ASR_THREADS=2
# Optional Whisper fallback for other languages (not recommended for Hindi/English)
ASR_MODEL=
TTS_MODEL=
TRANSLATE_MODEL=
# No language model is needed for patient intake. Optional, doctor-side note drafting only:
LLM_GGUF=
OCR_ENGINE=
