{
  "name": "aiia-medikiosk-backend",
  "version": "1.0.0",
  "description": "AIIA Pre-Consultation MediKiosk & Ambient Scribing Sovereign Engine",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && (cp -r src/data dist/ 2>/dev/null || true)",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "seed": "tsx src/db/seed.ts",
    "test": "node --expose-gc --import tsx tests/runner.ts",
    "test:opd": "tsx tests/opd_benchmark.test.ts",
    "test:kyc": "tsx tests/kyc_pii_redaction.test.ts",
    "test:contraindications": "tsx tests/contraindications.test.ts",
    "test:fhir": "tsx tests/fhir_validation.test.ts",
    "test:zkp": "tsx tests/zkp_verification.test.ts",
    "test:stress": "tsx tests/stress_100k.test.ts",
    "benchmark:efficiency": "tsx tests/deep_system_efficiency_benchmark.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "restore-backup": "tsx scripts/restore-backup.ts",
    "backup": "tsx -e \"require('./src/services/backup.service').runBackup().then(r=>{console.log(r);process.exit(0)})\"",
    "test:lexicon": "tsx tests/clinical_lexicon.test.ts",
    "test:extraction": "tsx tests/extraction_gold.test.ts",
    "test:safety": "tsx tests/clinical_safety_context.test.ts",
    "test:interview": "tsx tests/interview_engine.test.ts",
    "calibrate:conformal": "tsx scripts/calibrate-conformal.ts",
    "import:namaste": "tsx scripts/import-namaste.ts",
    "test:http": "tsx tests/http_api.test.ts",
    "eval:safety": "tsx tests/safety_benchmark.test.ts",
    "fhir:code-displays": "tsx scripts/fhir-code-displays.ts",
    "explain": "tsx scripts/explain-summary.ts",
    "test:no-llm": "tsx tests/no_llm_guarantee.test.ts",
    "sync:kiosk-labels": "tsx scripts/sync-kiosk-labels.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-seal": "^5.1.5",
    "snarkjs": "^0.7.5",
    "uuid": "^11.0.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
