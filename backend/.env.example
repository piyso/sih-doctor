# ---------------------------------------------------------------------------
# Hospital OS backend configuration. Copy to .env and adjust.
# In production set NODE_ENV=production: demo data is then OFF and kiosks
# must be enrolled by an administrator.
# ---------------------------------------------------------------------------
PORT=8001
NODE_ENV=development
DB_PATH=./data/hospital.db
# Folder for keys (signing + field encryption) and backups. Back it up!
# DATA_DIR=./data
HOSPITAL_TIMEZONE=Asia/Kolkata
HOSPITAL_SHORT_NAME=AIIA Hospital

# --- Security --------------------------------------------------------------
# Comma-separated browser origins allowed to call the API (production).
# Leave empty when the frontend is served from the same origin (nginx proxy).
CORS_ORIGIN=
# Demo patients and demo staff accounts. Never "true" with real patients.
# ALLOW_DEMO_DATA=false
# Allow kiosks to call the API without enrolment (development only).
# KIOSK_OPEN=false
TRUST_PROXY=true
STAFF_SESSION_HOURS=12
STAFF_IDLE_MINUTES=30
# First-run setup screen needs this code in production.
SETUP_CODE=
# Or create the first admin at start-up (must change PIN at first sign-in):
# ADMIN_BOOTSTRAP_USERNAME=admin
# ADMIN_BOOTSTRAP_PIN=
# Optional: provide keys instead of the generated files in DATA_DIR/keys
# SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# FIELD_ENCRYPTION_KEY=<32 bytes base64>

# --- DPDP retention ----------------------------------------------------------
DRAFT_RETENTION_HOURS=24
ABANDONED_SESSION_DAYS=30
CLINICAL_RETENTION_YEARS=3
GRIEVANCE_OFFICER_NAME=Hospital Data Protection Officer
GRIEVANCE_OFFICER_EMAIL=
GRIEVANCE_OFFICER_PHONE=

# --- Backups -----------------------------------------------------------------
# BACKUP_DIR=./data/backups      (copy this folder off the machine regularly)
BACKUP_HOUR=2
BACKUP_KEEP=14
# BACKUP_ENCRYPTION_KEY=<32 bytes base64; defaults to the field-encryption key>

# --- SMS (log | msg91 | webhook) ---------------------------------------------
SMS_PROVIDER=log
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_TOKEN_ISSUED=      (DLT-approved template ids)
# MSG91_TEMPLATE_RX_READY=
# MSG91_TEMPLATE_FOLLOW_UP=
# SMS_WEBHOOK_URL=
# SMS_WEBHOOK_TOKEN=

# --- Thermal printer (ESC/POS over TCP) --------------------------------------
# Default printer for kiosks that have none set in Admin > Kiosks.
# THERMAL_PRINTER_HOST=192.168.1.50:9100

# --- On-premise Edge AI service (edge-ai/) -------------------------------------
EDGE_AI_URL=http://127.0.0.1:8090
# EDGE_AI_TOKEN=

# --- ABDM (sandbox credentials from NHA) -------------------------------------
# ABDM_CLIENT_ID=
# ABDM_CLIENT_SECRET=
# ABDM_GATEWAY_URL=https://dev.abdm.gov.in/gateway
# ABDM_ABHA_URL=https://abhasbx.abdm.gov.in/abha/api

ZKP_CIRCUIT_DIR=./src/data/zkp_circuit
